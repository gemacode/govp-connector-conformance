{
  "name": "@gemacode/govp-connector-conformance",
  "version": "0.1.0",
  "description": "Independent technical conformance runner for GOVP Exchange connectors.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gemacode/govp-connector-conformance.git"
  },
  "homepage": "https://github.com/gemacode/govp-connector-conformance#readme",
  "bugs": {
    "url": "https://github.com/gemacode/govp-connector-conformance/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "prepack": "npm run check"
  },
  "dependencies": {
    "@gemacode/govp-connector-kit": "https://github.com/gemacode/govp-connector-kit/releases/download/v0.1.1/gemacode-govp-connector-kit-0.1.1.tgz"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "~5.9.3",
    "vitest": "^4.1.0"
  }
}
